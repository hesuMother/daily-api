PORT=3000
NODE_ENV=development
API_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
SWAGGER_EXTRA_SERVERS=
DATABASE_URL=postgresql://app_user:app_password@localhost:5432/app_db?schema=public
REDIS_URL=redis://127.0.0.1:6379
REDIS_KEY_PREFIX=daily:auth
# 각각 별도의 충분히 긴 난수로 설정합니다. 예시 값을 그대로 사용하지 마세요.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=daily-api
JWT_AUDIENCE=daily-web
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
# 별도 사이트의 프론트는 none을 사용하고 CORS_ORIGINS에 정확한 Origin을 지정합니다.
# 모든 환경에서 Secure=true입니다. 브라우저 쿠키 인증 테스트는 HTTPS를 사용하세요.
REFRESH_COOKIE_SAME_SITE=lax
USE_REVERSE_PROXY=false
# USE_REVERSE_PROXY=true일 때 실제 프록시 IP/CIDR을 쉼표로 구분해 지정합니다.
# 같은 호스트의 프록시 예: TRUSTED_PROXIES=127.0.0.1,::1
TRUSTED_PROXIES=

# 공식 Partners API 계약 구현 후 활성화합니다. 다중 인스턴스에서는 한 곳만 true.
COUPANG_SYNC_ENABLED=false
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
COUPANG_SUB_ID=
COUPANG_SYNC_KEYWORDS=
COUPANG_SYNC_CRON=0 0 */6 * * *
COUPANG_TIMEOUT_MS=10000
# 아래 수치는 운영 조절값이며 쿠팡의 공식 호출 제한이 아닙니다.
COUPANG_REQUEST_INTERVAL_MS=1000
COUPANG_MAX_RETRIES=2
COUPANG_RETRY_BASE_MS=1000
COUPANG_MAX_BACKOFF_MS=60000

# Local Docker Compose defaults; use separate credentials in production.
POSTGRES_USER=app_user
POSTGRES_DB=app_db
POSTGRES_PASSWORD=app_password

# Private outfit photos; use a persistent shared volume for multiple instances.
OUTFIT_UPLOAD_DIR=.data/outfits

DISCORD_NOTIFICATIONS_ENABLED=false

DISCORD_REPORT_WEBHOOK_URL=

DISCORD_CONTACT_WEBHOOK_URL=
